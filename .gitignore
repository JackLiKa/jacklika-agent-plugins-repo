node_modules/
lib/
artifacts/
*.tsbuildinfo

# Local dsh session state and the Bundle's default per-project memory vault.
# <session workspace>/.plugins/memory/ is the default when installed through
# @jacklika/dsh-memory; <session workspace>/.dsh/memory/ is the per-plugin
# fallback when no Bundle patch is applied.
.dsh/
.plugins/
.playwright-mcp/

# pnpm may create a per-project virtual store depending on configuration.
# The real global store is elsewhere; this local directory should never be
# committed because it contains resolved symlinks and absolute-ish paths.
.pnpm-store/
