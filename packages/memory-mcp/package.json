{
  "name": "@jacklika/dsh-memory-mcp",
  "description": "MCP stdio server exposing the memory vault to any MCP client — one process owns all writes.",
  "version": "0.1.4-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackLiKa/jacklika-agent-plugins-repo.git",
    "directory": "packages/memory-mcp"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "src/server.mjs",
  "types": "src/server.d.ts",
  "bin": {
    "dsh-memory-mcp": "src/server.mjs"
  },
  "exports": {
    ".": "./src/server.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/server.mjs",
    "src/server.d.ts",
    "README.md",
    "README.zh.md"
  ],
  "dependencies": {
    "@jacklika/dsh-memory-time": "workspace:^",
    "js-yaml": "^4.2.0"
  },
  "license": "MIT"
}
