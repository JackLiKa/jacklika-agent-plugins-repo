{
  "name": "@jacklika/dsh-memory-scope",
  "description": "Partitions memory-tool write ids into per-agent namespaces through the tools/execute waterfall so agents cannot collide on the same note by construction.",
  "version": "0.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackLiKa/mydsh-plugin.git",
    "directory": "packages/memory-scope"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cordis-plugin-include": "*",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@jacklika/dsh-tool-memory-filesystem": "workspace:*"
  }
}
