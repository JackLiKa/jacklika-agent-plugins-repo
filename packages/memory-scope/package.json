{
  "name": "@jacklika/dsh-memory-scope",
  "description": "Partitions memory-tool write ids into per-agent namespaces through the tools/execute waterfall so agents cannot collide on the same note by construction.",
  "version": "0.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackLiKa/mydsh-plugin.git",
    "directory": "packages/memory-scope"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1"
  },
  "devDependencies": {
    "@jacklika/dsh-tool-memory-filesystem": "workspace:*"
  }
}
