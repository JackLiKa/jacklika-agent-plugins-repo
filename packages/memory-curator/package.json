{
  "name": "@jacklika/dsh-memory-curator",
  "description": "Curator tools for the DSH memory vault: memory_recall before acting and memory_capture after significant work, with conflict detection and optional user approval.",
  "version": "0.1.0-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackLiKa/jacklika-agent-plugins-repo.git",
    "directory": "packages/memory-curator"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@jacklika/dsh-memory-time": "workspace:^",
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-util-values": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@jacklika/dsh-tool-memory-filesystem": "workspace:^"
  }
}
