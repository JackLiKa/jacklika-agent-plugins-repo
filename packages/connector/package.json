{
  "name": "@jacklika/dsh-connector",
  "description": "Bundle combining Qoder and Devin CLI connectors for DeepSeek Harness",
  "version": "0.1.0-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackLiKa/jacklika-agent-plugins-repo.git",
    "directory": "packages/connector"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@jacklika/dsh-qoder-connect": "workspace:^",
    "@jacklika/dsh-devin-connect": "workspace:^"
  }
}
