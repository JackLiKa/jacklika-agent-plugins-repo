{
  "name": "@jacklika/dsh-memory",
  "description": "The dsh memory bundle: an Obsidian-compatible Markdown vault with per-agent write namespaces, serialized writes, and git history as a patch layer over dsh-base",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackLiKa/mydsh-plugin.git",
    "directory": "packages/memory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@jacklika/dsh-memory-git": "workspace:*",
    "@jacklika/dsh-memory-queue": "workspace:*",
    "@jacklika/dsh-memory-scope": "workspace:*",
    "@jacklika/dsh-tool-memory-filesystem": "workspace:*",
    "@jacklika/dsh-tool-memory-graph": "workspace:*",
    "@jacklika/dsh-tool-memory-vector": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cordis-plugin-include": "*",
    "@deepseek-ai/cordis-plugin-loader": "*"
  }
}
