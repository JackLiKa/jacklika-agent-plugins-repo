{
  "name": "mydsh-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "JackLiKa's DeepSeek Harness plugin suite: the memory vault chain and future plugin packs.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackLiKa/mydsh-plugin.git"
  },
  "scripts": {
    "test": "vitest run && node packages/memory-mcp/tests/smoke.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "build": "tsc -b",
    "verify-translation-pairing": "node scripts/verify-translation-pairing.mjs",
    "pack:all": "pnpm build && node scripts/pack-all.mjs",
    "test:pack": "pnpm build && node scripts/verify-pack.mjs",
    "test:profile": "pnpm build && node scripts/verify-profile-install.mjs",
    "test:multiprocess": "pnpm build && node scripts/verify-multiprocess.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.1.7-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.7-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.7-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.7-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "js-yaml": "^4.2.0",
    "oxlint": "1.76.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
